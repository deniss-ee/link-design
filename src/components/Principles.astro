---
import type { Copy } from "../i18n/en";
interface Props { t: Copy }
const { t } = Astro.props;
const p = t.principles;
---

<section id="principles" class="bg-ink text-paper">
  <div class="gutter py-20 md:py-28">
    <div class="grid gap-x-10 gap-y-8 md:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)]">
      <div>
        <p class="label !text-paper/60">{p.label}</p>
        <h2 class="h-display mt-2 text-[clamp(2.25rem,4vw,3.25rem)]">{p.title}</h2>
      </div>
      <div class="max-w-[40rem] space-y-6 text-[1.375rem] leading-[1.4]">
        {p.items.map((item) => (
          <p><strong class="font-display font-semibold">{item.title}</strong> {item.text}</p>
        ))}
      </div>
    </div>

    <dl class="mt-16 grid gap-x-6 gap-y-8 sm:grid-cols-2 md:ml-[calc(40%+1.25rem)] md:grid-cols-2 lg:grid-cols-4">
      {p.colophon.map((row) => (
        <div class="border-t border-paper/30 pt-3">
          <dt class="label !text-paper/60">{row.k}</dt>
          <dd class="font-mono mt-2 text-[0.8125rem]">{row.v}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
