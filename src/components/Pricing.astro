---
import type { Copy } from "../i18n/en";
import { plans } from "../data/plans";
interface Props { t: Copy }
const { t } = Astro.props;
const p = t.pricing;
---

<section id="pricing" class="bg-sand">
  <div class="gutter py-16 md:py-24">
    <div class="grid gap-x-10 gap-y-8 md:grid-cols-2">
      <div>
        <p class="label">{p.label}</p>
        <h2 class="h-section mt-1">{p.title[0]}<br />{p.title[1]}</h2>
      </div>
      <p class="max-w-[34rem] text-[1.0625rem] leading-[1.55] text-muted md:pt-8">{p.intro}</p>
    </div>

    <ol class="mt-14 grid gap-y-8 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4 lg:gap-y-0">
      {plans.map((plan, i) => {
        const copy = p.plans[plan.id];
        const featured = !!plan.featured;
        const border = i > 0 && !plan.featured && !plans[i - 1]?.featured;
        return (
          <li
            class:list={[
              "relative flex flex-col px-6 pb-10 pt-8",
              featured && "bg-ink text-paper lg:-mt-6 lg:pt-14 lg:pb-12",
              border && "lg:border-l lg:border-rule",
            ]}
          >
            {featured && (
              <p class="label absolute right-4 top-4 !text-accent-on-dark">{p.pick}</p>
            )}
            <div class="flex items-baseline justify-between">
              <h3 class="font-display text-[1.75rem] font-medium leading-none">{copy.name}</h3>
              <span class:list={["label", featured && "!text-paper/60"]}>{String(i + 1).padStart(2, "0")}</span>
            </div>

            <p class="font-display mt-12 flex items-baseline gap-2 text-[4.25rem] font-normal leading-none tracking-[-0.03em]">
              {plan.price}
              <span class:list={["label !normal-case", featured && "!text-paper/70"]}>{plan.unit === "hour" ? p.perHour : p.perMonth}</span>
            </p>
            <p class:list={["mt-3 text-base", featured ? "text-paper/80" : "text-muted"]}>{copy.tagline}</p>

            <dl class="mt-8 flex-1">
              {copy.cardRows.map((key) => (
                <div class:list={["flex items-baseline justify-between gap-4 border-t py-2.5", featured ? "border-paper/25" : "border-rule"]}>
                  <dt class:list={["label", featured && "!text-paper/60"]}>{p.specLabels[key]}</dt>
                  <dd class="font-mono text-right text-[0.8125rem] leading-snug">{copy.specs[key]}</dd>
                </div>
              ))}
            </dl>

            <a
              href="#contact"
              class:list={["cta-arrow mt-8 self-start text-[1.25rem]", featured && "hover:!text-accent-on-dark"]}
            >{p.start} →</a>
          </li>
        );
      })}
    </ol>
  </div>
</section>
