---
// Scrolling strip of client wordmarks. Controlled by logos.enabled in the story block.
interface Props { label: string; names: string[] }
const { label, names } = Astro.props;
// Two identical groups; the track slides -50% so the loop is seamless.
const groups = [0, 1];
// Repeat the names so one group is always wider than a wide screen.
const row = [...names, ...names];
---

<div class="border-t border-rule py-5" role="group" aria-label={label}>
  <div class="overflow-hidden">
    <p class="sr-only">{names.join(", ")}</p>
    <div class="marquee-track" aria-hidden="true">
      {groups.map(() => (
        <ul class="flex shrink-0 items-center">
          {row.map((name) => (
            <li class="font-display whitespace-nowrap px-8 text-[1.375rem] font-medium italic text-muted md:px-12">{name}</li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</div>
