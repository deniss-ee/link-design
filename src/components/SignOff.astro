---
import type { Copy } from "../i18n/en";
import { config } from "../data/config";
interface Props { t: Copy }
const { t } = Astro.props;
const s = t.signoff;
---

<section id="contact" class="gutter pb-16 pt-8 md:pb-24">
  <div class="rule-top pt-16 md:pt-28">
    <p class="label">{s.label}</p>
    <h2 class="h-display mt-6 text-[clamp(2.75rem,7.6vw,6.25rem)] font-medium leading-[0.98] tracking-[-0.03em]">
      {s.title[0]}<br />{s.title[1]} <em class="font-normal text-accent">{s.title[2]}</em><br />{s.title[3]}
    </h2>
  </div>

  <dl class="rule-top mt-14 grid gap-x-6 gap-y-8 pt-6 md:grid-cols-3">
    <div>
      <dt class="label">{s.direct}</dt>
      <dd class="mt-2">
        <a href={`mailto:${config.email}`} class="font-display block border-b border-ink pb-1 text-[1.75rem] hover:text-accent">{config.email}</a>
      </dd>
    </div>
    <div>
      <dt class="label">{s.telegram}</dt>
      <dd class="mt-2">
        <a href={config.telegram.url} rel="noopener" class="font-display block border-b border-ink pb-1 text-[1.75rem] hover:text-accent">{config.telegram.handle}</a>
      </dd>
    </div>
    <div>
      <dt class="label">{s.booking}</dt>
      <dd class="font-mono mt-2 text-[0.8125rem] leading-snug">{s.bookingText}</dd>
    </div>
  </dl>
</section>
