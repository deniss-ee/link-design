---
import type { Copy } from "../i18n/en";
import { config } from "../data/config";
import Logos from "./Logos.astro";
interface Props { t: Copy }
const { t } = Astro.props;
const s = t.story;
---

<section id="story" class="flex min-h-[100svh] flex-col bg-sand">
  <div class="gutter flex flex-1 items-center py-16 md:py-20">
    <div class="grid w-full gap-x-24 gap-y-14 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
      <div>
        <h2 class="font-display text-[clamp(2.25rem,4.4vw,3.5rem)] font-semibold leading-[1.05] tracking-[-0.025em]">{s.title}</h2>
        <ul class="font-display mt-8 space-y-2 text-[clamp(1.25rem,2vw,1.75rem)] leading-snug text-muted">
          {s.situations.map((line) => <li>{line}</li>)}
        </ul>
        <p class="font-display mt-8 text-[clamp(1.375rem,2.2vw,2rem)] font-medium italic leading-snug text-accent">{s.resolve}</p>
      </div>

      <div>
        <h2 class="font-display text-[clamp(1.75rem,3vw,2.25rem)] font-semibold leading-[1.1] tracking-[-0.02em]">{s.howTitle}</h2>
        <ol class="mt-6 border-t border-rule">
          {s.steps.map((step) => (
            <li class="border-b border-rule py-4">
              <h3 class="font-display text-[1.375rem] font-medium leading-snug">{step.title}</h3>
              <p class="mt-1 text-[1.0625rem] leading-[1.5] text-muted">{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>

  {config.features.logos && (
    <div class="gutter">
      <Logos label={s.logosLabel} />
    </div>
  )}
</section>
