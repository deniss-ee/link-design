---
import type { Copy } from "../i18n/en";
interface Props { t: Copy }
const { t } = Astro.props;
const total = String(t.method.steps.length).padStart(2, "0");
---

<section id="method" class="bg-sand">
  <div class="gutter py-16 md:py-24">
    <div class="flex items-baseline justify-between gap-6">
      <p class="label">{t.method.label}</p>
      <p class="label text-right">{t.method.tag}</p>
    </div>
    <h2 class="h-section mt-1">{t.method.title}</h2>

    <ol class="mt-14 grid gap-y-10 sm:grid-cols-2 lg:mt-20 lg:grid-cols-4 lg:gap-y-0">
      {t.method.steps.map((step, i) => (
        <li class:list={["px-6 lg:border-l lg:border-rule", i === 0 && "lg:border-l-0"]}>
          <div class="label flex justify-between">
            <span>{String(i + 1).padStart(2, "0")}</span><span>/{total}</span>
          </div>
          <h3 class="font-display mt-6 text-[1.75rem] font-medium leading-tight">{step.title}</h3>
          <p class="mt-3 text-[0.9375rem] leading-[1.6] text-muted">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
