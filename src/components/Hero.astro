---
import type { Copy } from "../i18n/en";
import { config } from "../data/config";
interface Props { t: Copy }
const { t } = Astro.props;
const [l1, l2a, l2b] = t.hero.title;
const word = l2b.replace(/\.$/, "");
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-50 focus:bg-ink focus:px-3 focus:py-2 focus:text-paper"
>{t.ui.skip}</a>

<section id="top" class="gutter flex min-h-[100svh] flex-col">
  <header class="flex items-baseline justify-between py-6">
    <a href="#top" class="font-display text-xl font-semibold tracking-[-0.01em]">{config.name}</a>
    <a href="#contact" class="link-u text-base">{t.header.cta}</a>
  </header>

  <div class="flex flex-1 flex-col justify-center pb-24 pt-10">
    <h1 class="font-display text-[clamp(3.5rem,11.5vw,10rem)] font-medium leading-[0.9] tracking-[-0.035em]">
      <span class="block">{l1}</span>
      <span class="block whitespace-nowrap">
        <em class="font-normal">{l2a}</em>{" "}
        <span class="underline decoration-rule decoration-1 underline-offset-[0.14em]">{word}</span>.
      </span>
    </h1>

    <p class="mt-10 max-w-[34rem] text-[clamp(1.1875rem,1.8vw,1.4375rem)] leading-[1.45] text-muted">{t.hero.sub}</p>

    <a href="#contact" class="font-display mt-10 inline-block self-start text-[1.5rem] font-medium underline decoration-1 underline-offset-[0.3em] hover:text-accent">
      {t.hero.cta} →
    </a>
  </div>
</section>
