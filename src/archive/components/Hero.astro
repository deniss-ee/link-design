---
import type { Copy } from "../i18n.en";
interface Props { t: Copy }
const { t } = Astro.props;
const [l1, l2a, l2b] = t.hero.title;
const word = l2b.replace(/\.$/, "");
---

<section id="top" class="gutter">
  <div class="grid gap-x-10 gap-y-10 py-14 md:py-20 lg:grid-cols-[10.25rem_minmax(0,1fr)_17.8rem] lg:gap-y-0">
    <p class="label lg:pt-[3.2rem]">{t.hero.label}</p>

    <div>
      <h1 class="h-display text-[clamp(3.25rem,10.2vw,8.25rem)] leading-[0.9] tracking-[-0.03em]">
        <span class="block font-medium">{l1}</span>
        <span class="block whitespace-nowrap">
          <em class="font-normal">{l2a}</em>{" "}
          <span class="font-medium underline decoration-rule decoration-1 underline-offset-[0.14em]">{word}</span><span class="font-medium">.</span>
        </span>
      </h1>
      <p class="mt-10 max-w-[38rem] text-[clamp(1.125rem,1.75vw,1.375rem)] leading-[1.45]">{t.hero.sub}</p>
    </div>

    <aside class="self-end">
      <dl class="rule-top">
        {t.hero.aside.map((row) => (
          <div class="rule-bottom flex items-baseline justify-between py-2.5 last:border-b-0">
            <dt class="label">{row.k}</dt>
            <dd class="label label-ink">{row.v}</dd>
          </div>
        ))}
      </dl>
      <a href="#contact" class="cta-arrow mt-8 inline-block">{t.hero.cta} →</a>
    </aside>
  </div>
</section>
