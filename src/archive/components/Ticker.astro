---
import type { Copy } from "../i18n.en";
interface Props { t: Copy }
const { t } = Astro.props;
// Four copies; track translates -50% so the loop is seamless at any width.
const copies = [0, 1, 2, 3];
---

<div class="rule-top rule-bottom overflow-hidden py-3">
  <p class="sr-only">{t.ticker.join(", ")}</p>
  <div class="ticker-track label label-ink" aria-hidden="true">
    {copies.map(() => (
      <div class="flex shrink-0">
        {t.ticker.map((item) => (
          <span class="whitespace-nowrap px-5">{item}<span class="pl-10 text-muted">·</span></span>
        ))}
      </div>
    ))}
  </div>
</div>
