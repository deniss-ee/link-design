# Copy to .env for local use. Never commit .env.

# "dev" adds noindex + Disallow: / (staging). Leave unset for production.
PUBLIC_SITE_ENV=dev

# Absolute URL of this deployment (canonical, sitemap, OG tags).
SITE_URL=https://dev.link.design

# Web3Forms access key for the brief form (public by design, not a secret).
# Get one at https://web3forms.com by entering the inbox that should receive briefs.
# Empty = the form opens the visitor's mail app instead.
PUBLIC_WEB3FORMS_KEY=

# Optional: Cloudflare Web Analytics token (cookieless). Empty = no analytics.
PUBLIC_CF_ANALYTICS_TOKEN=
